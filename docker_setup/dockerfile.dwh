FROM python:3.13-slim

ENV DBT_PROFILES_DIR=/pipeline \
    UV_NO_CACHE=1 \
    PATH="/pipeline/.venv/bin:$PATH"

WORKDIR /pipeline
COPY pyproject.toml uv.lock ./

RUN pip install --no-cache-dir uv
RUN uv sync --locked --no-dev

COPY data_extract_load/ ./data_extract_load/
COPY data_transformation/ ./data_transformation/
COPY orchestration/ ./orchestration/
COPY docker_setup/profiles.yml /pipeline/profiles.yml

RUN dbt deps --project-dir data_transformation
RUN SNOWFLAKE_ACCOUNT=x DBT_SNOWFLAKE_PASSWORD=x dbt parse --project-dir data_transformation

CMD ["dagster", "dev", "-f", "orchestration/definitions.py", "-h", "0.0.0.0", "-p", "3000"]
